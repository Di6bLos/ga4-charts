---
interface Props {
  bounceRate: number;
  avgSessionDuration: number;
  engagementRate: number;
  realtimeUsers: number;
}
const { bounceRate, avgSessionDuration, engagementRate, realtimeUsers } = Astro.props;

function fmtDuration(s: number): string {
  const m = Math.floor(s / 60);
  const sec = s % 60;
  return `${m}m ${String(sec).padStart(2, '0')}s`;
}
---

<div class="kpi-row">
  <div class="kpi-card">
    <span class="kpi-label">Bounce Rate</span>
    <span class="kpi-value" id="kpi-bounce">{bounceRate}%</span>
    <span class="kpi-trend down">↓ lower is better</span>
  </div>
  <div class="kpi-card">
    <span class="kpi-label">Avg. Session Duration</span>
    <span class="kpi-value" id="kpi-duration">{fmtDuration(avgSessionDuration)}</span>
    <span class="kpi-trend up">↑ higher is better</span>
  </div>
  <div class="kpi-card">
    <span class="kpi-label">Engagement Rate</span>
    <span class="kpi-value" id="kpi-engagement">{engagementRate}%</span>
    <span class="kpi-trend up">↑ higher is better</span>
  </div>
  <div class="kpi-card realtime">
    <span class="kpi-label">
      <span class="pulse-dot"></span>
      Realtime Active Users
    </span>
    <span class="kpi-value" id="kpi-realtime">{realtimeUsers}</span>
    <span class="kpi-trend neutral">Updates every 30s</span>
  </div>
</div>

<script define:vars={{ realtimeUsers }}>
  function fmtDuration(s) {
    const m = Math.floor(s / 60);
    const sec = s % 60;
    return `${m}m ${String(sec).padStart(2, '0')}s`;
  }

  window.addEventListener('ga4:update', (e) => {
    const { kpis } = e.detail.data;
    document.getElementById('kpi-bounce').textContent = kpis.bounceRate + '%';
    document.getElementById('kpi-duration').textContent = fmtDuration(kpis.avgSessionDuration);
    document.getElementById('kpi-engagement').textContent = kpis.engagementRate + '%';
  });

  function pollRealtime() {
    const val = Math.floor(Math.random() * 300 + 80);
    document.getElementById('kpi-realtime').textContent = val;
  }
  setInterval(pollRealtime, 30000);
</script>

<style>
  .kpi-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .kpi-card {
    background: #1e293b;
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .kpi-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .kpi-value {
    font-size: 2rem;
    font-weight: 700;
    color: #f1f5f9;
    line-height: 1;
  }
  .kpi-trend {
    font-size: 0.72rem;
    font-weight: 500;
  }
  .kpi-trend.up { color: #34d399; }
  .kpi-trend.down { color: #34d399; }
  .kpi-trend.neutral { color: #64748b; }
  .realtime .kpi-value { color: #34d399; }
  .pulse-dot {
    width: 8px;
    height: 8px;
    background: #34d399;
    border-radius: 50%;
    display: inline-block;
    animation: pulse 1.8s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.7); }
  }
  @media (max-width: 900px) {
    .kpi-row { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .kpi-row { grid-template-columns: 1fr; }
  }
</style>
