---
interface Props {
  labels: string[];
  data: number[];
}

const { labels, data } = Astro.props;
---

<div class="chart-container">
  <h3>Pages Visited</h3>
  <canvas id="pages-chart"
    data-labels={JSON.stringify(labels)}
    data-data={JSON.stringify(data)}
  ></canvas>
</div>

<script>
  import { Chart, registerables } from 'chart.js';
  Chart.register(...registerables);

  const canvas = document.getElementById('pages-chart') as HTMLCanvasElement;
  const labels = JSON.parse(canvas.dataset.labels || '[]');
  const chartData = JSON.parse(canvas.dataset.data || '[]');

  const chart = new Chart(canvas, {
    type: 'bar',
    data: {
      labels,
      datasets: [{
        label: 'Page Views',
        data: chartData,
        backgroundColor: [
          '#6366f1', '#8b5cf6', '#a855f7', '#d946ef',
          '#ec4899', '#f43f5e', '#ef4444', '#dc2626',
          '#b91c1c', '#991b1b'
        ],
        borderRadius: 4,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      indexAxis: 'y',
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#94a3b8' } },
        y: { grid: { display: false }, ticks: { color: '#94a3b8' } }
      }
    }
  });

  window.addEventListener('ga4:update', (e) => {
    const { pages } = (e as CustomEvent).detail.data;
    chart.data.labels = pages.map((p: { label: string }) => p.label);
    chart.data.datasets[0].data = pages.map((p: { value: number }) => p.value);
    chart.update('none');
  });
</script>

<style>
  .chart-container {
    background: #1e293b;
    border-radius: 12px;
    padding: 1.5rem;
    height: 300px;
  }
  h3 { color: #f1f5f9; margin: 0 0 1rem; font-size: 1.1rem; }
  canvas { height: 220px !important; }
</style>