---
interface Props {
  labels: string[];
  data: number[];
}
const { labels, data } = Astro.props;
---

<div class="chart-container">
  <h3>Top Landing Pages</h3>
  <canvas id="landing-pages-chart"
    data-labels={JSON.stringify(labels)}
    data-data={JSON.stringify(data)}
  ></canvas>
</div>

<script>
  import { Chart, registerables } from 'chart.js';
  Chart.register(...registerables);

  const canvas = document.getElementById('landing-pages-chart') as HTMLCanvasElement;
  const labels = JSON.parse(canvas.dataset.labels || '[]');
  const chartData = JSON.parse(canvas.dataset.data || '[]');

  const chart = new Chart(canvas, {
    type: 'bar',
    data: {
      labels,
      datasets: [{
        label: 'Sessions',
        data: chartData,
        backgroundColor: [
          '#34d399', '#10b981', '#059669', '#047857',
          '#065f46', '#064e3b', '#6ee7b7', '#a7f3d0',
          '#d1fae5', '#ecfdf5',
        ],
        borderRadius: 4,
      }],
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      indexAxis: 'y',
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#94a3b8' } },
        y: { grid: { display: false }, ticks: { color: '#94a3b8', font: { size: 11 } } },
      },
    },
  });

  window.addEventListener('ga4:update', (e) => {
    const { landingPages } = (e as CustomEvent).detail.data;
    chart.data.labels = landingPages.map((p: { label: string }) => p.label);
    chart.data.datasets[0].data = landingPages.map((p: { value: number }) => p.value);
    chart.update('none');
  });
</script>

<style>
  .chart-container {
    background: #1e293b;
    border-radius: 12px;
    padding: 1.5rem;
    height: 360px;
  }
  h3 { color: #f1f5f9; margin: 0 0 1rem; font-size: 1.1rem; }
  canvas { height: 280px !important; }
</style>
